@@ -0,0 +1,50 @@
+import { exportToCanvas, FONT_FAMILY } from '@excalidraw/excalidraw'
+
+interface FontElement {
+  type?: string;
+  isDeleted?: boolean;
+  text?: string;
+  originalText?: string;
+  fontFamily?: number;
+  label?: { text: string; fontFamily?: number };
+}
+
+let registration: Promise<void> | undefined
+
+// The public native export registers all bundled faces, including unicode
+// subsets, even for an empty scene. Avoid measuring any text until they load.
+export const loadSceneFonts = async (elements: readonly FontElement[]): Promise<void> => {
+  const textByFamily = new Map<number, Set<string>>()
+  for (const element of elements) {
+    if (element.isDeleted) continue
+    const label = element.type === 'text' ? element : element.label
+    const text = label && ('originalText' in label ? label.originalText : undefined) || label?.text
+    if (!text) continue
+    const family = label?.fontFamily ?? FONT_FAMILY.Excalifont
+    const chars = textByFamily.get(family) ?? new Set<string>()
+    for (const char of text) chars.add(char)
+    textByFamily.set(family, chars)
+  }
+  if (!textByFamily.size) return
+  registration ??= exportToCanvas({
+    elements: [], files: {},
+    getDimensions: () => ({ width: 1, height: 1, scale: 1 }),
+  }).then(() => undefined).catch((error: unknown) => {
+    registration = undefined
+    throw error
+  })
+  await registration
+  await Promise.all([...textByFamily].map(async ([id, chars]) => {
+    const family = Object.entries(FONT_FAMILY).find(([, value]) => value === id)?.[0]
+    if (!family) throw new Error(`Unsupported canvas font family: ${id}`)
+    const font = `16px "${family}"${id === FONT_FAMILY.Excalifont ? ', "Xiaolai"' : ''}, "Segoe UI Emoji"`
+    // fonts.ready alone can resolve before the required faces are registered.
+    // Explicit loading rejects unavailable local assets instead of measuring a
+    // fallback font and later clipping a wider glyph in a stale text raster.
+    const loaded = await document.fonts.load(font, [...chars].join(''))
+    if ((!loaded.length && id !== FONT_FAMILY.Helvetica) ||
+        !document.fonts.check(font, [...chars].join(''))) {
+      throw new Error(`Canvas font did not load: ${family}`)
+    }
+  }))
+}
