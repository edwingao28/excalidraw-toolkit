+// excalidraw-toolkit: the live-edit revision is a content hash of every
+// element, deleted ones included. Excalidraw's hashElementsVersion relies on
+// versionNonce changing, which server-merged updates do not guarantee. It is
+// synchronous (cyrb53) so the check and the apply stay in one step.
+const toolkitSceneRevision = (elements: readonly unknown[]): string => {
+  const text = JSON.stringify(elements)
+  let h1 = 0xdeadbeef
+  let h2 = 0x41c6ce57
+  for (let i = 0; i < text.length; i++) {
+    const code = text.charCodeAt(i)
+    h1 = Math.imul(h1 ^ code, 2654435761)
+    h2 = Math.imul(h2 ^ code, 1597334677)
+  }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909)
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909)
+  return `${text.length.toString(16)}-${(4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16)}`
+}
